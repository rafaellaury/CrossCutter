</Binding>
<Binding mode="twoWay">
<Source xsi:type="opcUa" refId="::Recipe:NewSyncRecipe.DegreesBefore" attribute="value" />
<Target xsi:type="brease" contentRefId="ContentNewRecipe" widgetRefId="NumericInputDegBefore" attribute="value" />
</Binding>
<Binding mode="twoWay">
<Source xsi:type="opcUa" refId="::Recipe:NewSyncRecipe.DegreesAfter" attribute="value" />
<Target xsi:type="brease" contentRefId="ContentNewRecipe" widgetRefId="NumericInputDegreeAfter" attribute="value" />
</Binding>
<Binding mode="twoWay">
<Source xsi:type="opcUa" refId="::Recipe:NewSyncRecipe.ConveyorDistance" attribute="value" />
<Target xsi:type="brease" contentRefId="ContentNewRecipe" widgetRefId="NumericInput3" attribute="value" />
</Binding>
<Binding mode="twoWay">
<Source xsi:type="opcUa" refId="::Recipe:CancelCreation" attribute="value" />
<Target xsi:type="brease" contentRefId="ContentNewRecipe" widgetRefId="MomentaryCancel" attribute="value" />
</Binding>
<Binding mode="twoWay">
