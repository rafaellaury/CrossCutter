<?xml version="1.0" encoding="utf-8"?>
<vdef:Visualization id="cross_cutter_vis" autoUpdate="true" xmlns:vdef="http://www.br-automation.com/iat2015/visualizationDefinition/v2">
  <StartPage pageRefId="MainPage" />
  <Pages>
    <Page refId="MainPage" />
    <Page refId="ManualPage" />
    <Page refId="AlarmsPage" />
    <Page refId="DiagPage" />
  </Pages>
  <Navigations />
  <BindingsSets>
    <BindingsSet refId="ContentAlarms_binding" />
    <BindingsSet refId="ContentManual_binding" />
    <BindingsSet refId="ContentLeft_binding" />
    <BindingsSet refId="ContentMain_binding" />
    <BindingsSet refId="ContentTop_binding" />
    <BindingsSet refId="ContentNewRecipe_binding" />
  </BindingsSets>
  <EventBindingsSets>
    <EventBindingsSet refId="ContentAlarms_eventbinding" />
    <EventBindingsSet refId="ContentMain_eventbinding" />
    <EventBindingsSet refId="ContentNewRecipe_eventbinding" />
    <EventBindingsSet refId="ContentLogin_eventbinding" />
    <EventBindingsSet refId="ContentLeft_eventbinding" />
  </EventBindingsSets>
  <Dialogs>
    <Dialog refId="NewRecipeDialog" />
    <Dialog refId="LoginDialog" />
  </Dialogs>
  <Contents>
    <Content refId="ContentMain" />
    <Content refId="ContentLeft" />
    <Content refId="ContentTop" />
    <Content refId="ContentDiagnostics" />
    <Content refId="ContentAlarms" />
    <Content refId="ContentManual" />
    <Content refId="ContentNewRecipe" />
    <Content refId="ContentLogin" />
  </Contents>
  <SnippetsSets />
  <VariablesSets />
  <ExpressionsSets />
  <StartTheme themeRefId="BuRThemeFlat1" />
  <Themes>
    <Theme refId="BuRThemeFlat1" />
  </Themes>
  <Configurations>
    <Configuration key="activityCount" value="false" />
    <Gestures>
      <!--<SystemGesture1 touchPoints="2" />
		  <SystemGesture2 touchPoints="2" />
		  <SystemGesture3 touchPoints="2" />-->
    </Gestures>
    <VirtualKeyboards>
      <!--<InputProcessing onKeyDown="true" />-->
    </VirtualKeyboards>
  </Configurations>
</vdef:Visualization>