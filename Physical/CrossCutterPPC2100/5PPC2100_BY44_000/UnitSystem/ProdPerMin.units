<?AutomationStudio FileVersion="4.9"?>
<Configuration>
  <Element ID="ProductsPerMinute" Type="Units" Description="Products per minute speed unit">
    <Property ID="Namespace" Value="http://www.br-automation.com/units" Description="B&amp;R namespace" />
    <Property ID="UnitID" Value="5262641" Description="Generated unit ID" />
    <Property ID="CommonCode" Value="PM1" Description="Products per minute (did not use PPM to avoid parts per million confusion)" />
