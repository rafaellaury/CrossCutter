<?xml version="1.0" encoding="utf-8"?>
<Content id="ContentLeft" height="700" width="160" xmlns="http://www.br-automation.com/iat2015/contentDefinition/v2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Widgets>
    <Widget xsi:type="widgets.brease.NavigationBar" id="NavigationBarCrossCutter" top="0" left="0" width="160" height="480" zIndex="0">
      <Widgets>
        <Widget xsi:type="widgets.brease.NavigationButton" id="NavigationButtonMainPage" top="20" left="20" width="120" height="60" zIndex="0" pageId="MainPage" text="Main Page" backColor="rgba(255, 255, 255, 1)" mouseDownBorderColor="rgba(255, 192, 128, 1)" checkedBorderColor="rgba(255, 215, 0, 1)" tooltip="Main operation page" />
        <Widget xsi:type="widgets.brease.NavigationButton" id="NavigationButtonManualPage" top="100" left="20" width="120" height="60" zIndex="1" pageId="ManualPage" text="Manual" mouseDownBorderColor="rgba(255, 192, 128, 1)" checkedBorderColor="rgba(255, 215, 0, 1)" tooltip="Manual operation page" />
        <Widget xsi:type="widgets.brease.NavigationButton" id="NavigationButtonAlarmsPage" top="180" left="20" width="120" height="60" zIndex="2" pageId="AlarmsPage" text="Alarms" mouseDownBorderColor="rgba(255, 192, 128, 1)" checkedBorderColor="rgba(255, 215, 0, 1)" tooltip="Alarms page" />
        <Widget xsi:type="widgets.brease.NavigationButton" id="NavigationButtonAlarmsPage1" top="260" left="20" width="120" height="60" zIndex="3" pageId="DiagPage" text="Diagnostics" mouseDownBorderColor="rgba(255, 192, 128, 1)" checkedBorderColor="rgba(255, 215, 0, 1)" permissionOperate="['Administrators', 'Service']" permissionView="['Administrators', 'Service']" tooltip="Diagnostics page" />
      </Widgets>
    </Widget>
    <Widget xsi:type="widgets.brease.Image" id="ImageLogin" top="560" left="50" width="60" height="80" zIndex="1" image="Media/SymbolLib/User/User.svg" tooltip="Login" />
    <Widget xsi:type="widgets.brease.LoginInfo" id="LoginInfo1" top="520" left="20" zIndex="2" textAlign="center" />
    <Widget xsi:type="widgets.brease.Label" id="LabelLoggedinAs" top="480" left="20" width="120" zIndex="3" text="Logged in as:" textAlign="center" fontSize="16px" />
    <Widget xsi:type="widgets.brease.LogoutButton" id="LogoutButtonLeft" top="640" left="20" width="120" zIndex="4" text="Logout" borderWidth="1px 1px 1px 1px" />
  </Widgets>
