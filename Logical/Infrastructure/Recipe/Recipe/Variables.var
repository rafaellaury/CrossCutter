(*local variables*)
VAR
	NewRecipe : BOOL; (*New recipe button*)
	CreateNewRecipe : BOOL; (*Create new recipe button*)
	CreateAccepted : BOOL; (*Variable to track when create has been accepted*)
	CancelCreation : BOOL; (*If recipe creation is cancelled, stop*)
	SaveRecipe : BOOL := FALSE; (*Command to save recipes*)
	RecipeList : ARRAY[0..19] OF STRING[100] := ['{"value":"defaultRecipe.xml","text":"defaultRecipe.xml"}',19('')]; (*List box data provider*)
	selectedValue : STRING[100]; (*Selected value from list box*)
	RecipeStatus : STRING[255]; (*Status variable for Recipe management*)
END_VAR
(*local function blocks*)
VAR
	MpRecipeRegPar_0 : MpRecipeRegPar; (*Registration of the recipe structure variable*)
	MpRecipeUI_0 : MpRecipeUI := (UISetup:=(RecipeListSize:=11,RecipeListScrollWindow:=0,Confirmation:=(RecipeLoad:=0,RecipeSave:=0,RecipeCreate:=0,RecipeDelete:=TRUE))); (*MpRecipeUI Component*)
	MpRecipeXml_0 : MpRecipeXml; (*Recipe Handling FUB*)
	LoadRecipe : BOOL; (*Load recipe*)
END_VAR
(*local constants*)
VAR CONSTANT
	RECIPE_FILENAME : STRING[255] := 'defaultRecipe.xml'; (*Default cutting recipe file name*)
	DEFAULT_DEG_BEFORE : LREAL := 10; (*[°] Default degrees before cut*)
	DEFAULT_DEG_AFTER : LREAL := 10; (*[°] Default degrees after cut*)
END_VAR
VAR
	DEFAULT_MM_CONVEYOR : {REDUND_UNREPLICABLE} LREAL := 20; (*[mm] Default conveyor distance*)
END_VAR
(*local structures*)
VAR
	MpRecipeUIConnect : MpRecipeUIConnectType := (Recipe:=(Filter:='*xml'),New:=(FileName:='newRecipe.xml')); (*MpRecipeUI connection datapoints*)
	NewSyncRecipe : SyncRecipeType; (*Sync recipe for new recipes*)
END_VAR
(*local enumerators*)
VAR
	RecipeCreateStep : RecipeCreateSteps := IDLE; (*Internal variable for recipe creating state machine*)
	RecipeCreateStepNew : RecipeCreateSteps := IDLE; (*Internal variable for recipe creating state machine*)
	Piece1 : STRING[80]; (*Helper for list box appending*)
	Piece2 : STRING[80]; (*Helper for list box appending*)
	Piece3 : STRING[80]; (*Helpder for list box appending*)
	NewListBoxEntry : STRING[100];
	NewFileName : STRING[80];
END_VAR
